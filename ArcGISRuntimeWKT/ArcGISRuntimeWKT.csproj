<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Version>0.2.0</Version>
    <Product>ArcGISRuntimeWKT</Product>
    <Title>ArcGISRuntimeWKT</Title>
    <Description>Library to convert WKT/WKB to/from Esri ArcGIS Runtime Geometry (for Runtime 200.x)</Description>
    <Copyright>Copyright © 2025</Copyright>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>ArcGISRuntimeWKT</PackageId> <!-- NuGet package ID -->
    <!-- Add other NuGet metadata like PackageLicenseExpression, ProjectUrl, RepositoryUrl etc. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Esri.ArcGISRuntime" Version="200.6.0" />
  </ItemGroup>

</Project>